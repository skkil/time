{
  "name": "@skkil-time/core-native",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "time-core and store-core in React Native: a Turbo Module generated by uniffi-bindgen-react-native",
  "repository": {
    "url": "https://github.com/skkil/time"
  },
  "main": "./src/index.ts",
  "react-native": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "cpp",
    "android",
    "ios",
    "*.podspec"
  ],
  "scripts": {
    "build:android": "./scripts/android.sh",
    "build:ios": "./scripts/ios.sh",
    "check:generated": "./scripts/android.sh && git diff --exit-code -- src/native cpp android ios CoreNative.podspec",
    "check:ios": "cargo check --target aarch64-apple-ios --no-default-features && cargo check --target aarch64-apple-ios-sim --no-default-features",
    "lint": "eslint .",
    "compile": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "codegenConfig": {
    "name": "NativeTimeCoreSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.skkil.time.core"
    }
  },
  "dependencies": {
    "@skkil/store-client": "link:../../../../store/modules/client-ts",
    "@skkil-time/local": "workspace:*",
    "@ubjs/core": "0.31.0-6",
    "uniffi-bindgen-react-native": "0.31.0-6"
  },
  "peerDependencies": {
    "react-native": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@skkil-time/tooling": "workspace:*",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "prettier": "@skkil-time/tooling/prettier"
}
