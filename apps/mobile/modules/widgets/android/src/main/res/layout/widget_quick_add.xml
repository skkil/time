<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_frame"
  android:clipToOutline="true"
  android:contentDescription="@string/widget_quick_add_name">

  <ImageView
    android:id="@+id/sky"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
      android:id="@+id/plus"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:background="@drawable/widget_glass_circle"
      android:fontFamily="sans-serif-light"
      android:gravity="center"
      android:importantForAccessibility="no"
      android:includeFontPadding="false"
      android:text="+"
      android:textColor="#fff1f1ee"
      android:textSize="26sp" />

    <TextView
      android:id="@+id/quick_add_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:maxLines="1"
      android:text="@string/widget_quick_add_name"
      android:textColor="#bff1f1ee"
      android:textSize="11sp" />
  </LinearLayout>
</FrameLayout>
