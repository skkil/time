{
  "name": "@skkil-time/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Typed client for the skkil time server, generated from openapi.json",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json --output src/schema.ts --root-types --root-types-no-schema-prefix && prettier --write src/schema.ts",
    "lint": "eslint .",
    "compile": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
