{
  "name": "@skkil-time/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Typed client for the skkil time server, generated from openapi.json",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./realtime": "./src/realtime.ts"
  },
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json --output src/schema.ts --root-types --root-types-no-schema-prefix && prettier --write src/schema.ts",
    "lint": "eslint .",
    "compile": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "check:generated": "pnpm generate && git diff --exit-code -- src/schema.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@skkil-time/config": "workspace:*",
    "eslint": "^10.14.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "prettier": "@skkil-time/config/prettier"
}
