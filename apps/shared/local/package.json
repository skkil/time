{
  "name": "@skkil-time/local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The app Backend over a local time-core engine: every command run on the device's replica",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs && prettier --write src/catalog.ts",
    "check:generated": "pnpm generate && git diff --exit-code -- src/catalog.ts",
    "lint": "eslint .",
    "compile": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@skkil-time/contract": "workspace:*"
  },
  "devDependencies": {
    "@skkil-time/config": "workspace:*",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "prettier": "@skkil-time/config/prettier"
}
